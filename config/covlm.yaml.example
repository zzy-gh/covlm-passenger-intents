control:
    target_point_distance: 10
    max_speed: 6.5
    slow_speed: 4.0
    turn_pid:
        K_P: 1.25
        K_I: 0.75
        K_D: 0.3
        n: 40
    speed_pid:
        K_P: 5.0
        K_I: 0.5
        K_D: 1.0
        n: 40

camera:
    wide_rgb:
        width: 900
        height: 600
        fov: 120
    tele_rgb:
        width: 900
        height: 600
        fov: 30
    topdown_rgb:
        width: 1000
        height: 1000
        fov: 80
    poses:
        front:
            x: 1.3
            y: 0.0
            z: 2.3
            roll: 0.0
            pitch: 0.0
            yaw: 0.0
        left:
            x: 1.3
            y: 0.0
            z: 2.3
            roll: 0.0
            pitch: 0.0
            yaw: -90.0
        right:
            x: 1.3
            y: 0.0
            z: 2.3
            roll: 0.0
            pitch: 0.0
            yaw: 90.0
        front_tele:
            x: 1.3
            y: 0.0
            z: 2.3
            roll: 0.0
            pitch: 0.0
            yaw: 0.0
        topdown:
            x: 0.0
            y: 0.0
            z: 40.0
            roll: 0.0
            pitch: -90.0
            yaw: 0.0

safety:
    visibility: global
    destroy_hazard_actors: false

route:
    weather: null
    waypoint_disturb: 0.0
    waypoint_disturb_seed: 2021

save:
    save_skip_frames: 5

debug:
    enabled: false
    interval: 1

cov2v:
    enabled: true
    interval: 30
    debug: true
    #python_bin: /home/avsaw1/miniconda3/envs/cov2v-gemini/bin/python
    python_bin: /home/dellpro2/miniconda3/envs/cov2v-gemini/bin/python
    # provider: gemini or qwen. Qwen uses the OpenAI-compatible DashScope API.
    provider: gemini
    gemini_api_key: ''
    qwen_api_key: ''
    model: gemini-2.5-flash
    base_url: 
    extra_body:
        enable_thinking: false
    temperature: 0.0
    cooperative_range_meters: 100.0
    negotiation_mode: discussion
    discussion_rounds: 2
    use_strategy_knowledge: true
    use_other_vehicle_observations: true
    system_prompt_path: cov2v/system_prompt.txt
    request_timeout_sec: 300.0
    retry_wait_sec: 10.0
    retry_attempts: 0
    jpeg_quality: 85
    # Per-scenario passenger utterances, looked up by the Interdrive route
    # directory name from the ROUTES_DIR env var that eval_driving.sh exports,
    # then merged into driver_intents below (this file wins on any vehicle id
    # present in both).
    driver_intents_path: simulation/leaderboard/team_code/agent_config/driver_intents_nav.yaml
    driver_intents:
        veh_0:
#            intent_type: medical_emergency
#            urgency_level: 3
#            requested_priority_bonus: 30
#            justification: "Medical emergency situation requiring passing first."
